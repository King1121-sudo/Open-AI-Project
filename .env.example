# Copy to .env and fill in the free-tier keys you want to use.
# Each is optional; routes with missing keys are skipped (failover).

# Pollinations.ai (free Pollen credits): https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=

# OpenRouter: https://openrouter.ai/keys  -> free :free model routes
OPENROUTER_API_KEY=

# Google AI Studio (Gemini free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY= 

# Groq: https://console.groq.com/keys
GROQ_API_KEY= 

# GitHub (Models): a personal access token works: https://github.com/settings/tokens
GITHUB_TOKEN=

# Mistral (free experiment plan): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cerebras (free tier): https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Together AI: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Z.AI (GLM-Flash free): https://bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=

# Cloudflare Workers AI: https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Gateway options
GATEWAY_PORT=8787
GATEWAY_TIMEOUT=60000
# Token compression: active with a ~64k token budget by default
# GATEWAY_COMPRESS=0           # disable
# GATEWAY_COMPRESS_BUDGET=64000
# Optional: require this key on incoming requests (Authorization: Bearer <key> or x-api-key)
# GATEWAY_KEY=your-secret