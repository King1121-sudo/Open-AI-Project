{
  "_comment": "Copy to gateway.config.json (or rely on defaults + .env). Streams are passed through with failover.",
  "port": 8787,
  "gatewayKey": "",
  "providers": {
    "openrouter": {
      "type": "openai",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "ENV:OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "http://localhost:8787",
        "X-Title": "Local Gateway"
      },
      "models": [
        "openai/gpt-oss-20b:free",
        "google/gemma-4-31b-it:free",
        "google/gemma-4-26b-a4b-it:free",
        "cohere/north-mini-code:free",
        "nvidia/nemotron-3-nano-30b-a3b:free"
      ]
    },
    "gemini": {
      "type": "gemini",
      "apiKey": "ENV:GEMINI_API_KEY",
      "models": ["gemini-3.5-flash", "gemini-3.1-flash-lite"]
    },
    "groq": {
      "type": "openai",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKey": "ENV:GROQ_API_KEY",
      "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"]
    },
    "github": {
      "type": "openai",
      "baseUrl": "https://models.github.ai/inference/v1",
      "apiKey": "ENV:GITHUB_TOKEN",
      "models": ["gpt-4o-mini", "gpt-4.1-mini"]
    },
    "cloudflare": {
      "type": "cloudflare",
      "accountId": "ENV:CF_ACCOUNT_ID",
      "apiKey": "ENV:CF_API_TOKEN",
      "models": ["@cf/qwen/qwen2.5-coder-32b-instruct", "@cf/meta/llama-3.1-8b-instruct"]
    }
  },
  "routes": {
    "default": [
      "groq/llama-3.3-70b-versatile",
      "openrouter/openai/gpt-oss-20b:free",
      "openrouter/cohere/north-mini-code:free",
      "gemini/gemini-3.5-flash"
    ],
    "coder": [
      "groq/llama-3.3-70b-versatile",
      "openrouter/cohere/north-mini-code:free",
      "openrouter/openai/gpt-oss-20b:free",
      "github/gpt-4o-mini"
    ],
    "fast": [
      "groq/llama-3.1-8b-instant",
      "openrouter/openai/gpt-oss-20b:free",
      "openrouter/google/gemma-4-31b-it:free"
    ]
  }
}